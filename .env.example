# 토스페이먼츠 테스트 키 (developers.tosspayments.com → 내 개발정보 → API 개별 연동 키)
# 이 파일을 .env.local 로 복사해서 값을 채우세요. .env.local 은 git에 올라가지 않습니다.

# 결제창용 공개 키 (test_ck_ 로 시작)
VITE_TOSS_CLIENT_KEY=

# 결제 승인용 비밀 키 (test_sk_ 로 시작) — 절대 코드·GitHub에 넣지 마세요
TOSS_SECRET_KEY=

# 간편 로그인 (각 개발자센터에서 발급, Redirect URI: <사이트주소>/auth/kakao · /auth/naver · /auth/google)
# 카카오: developers.kakao.com → 앱 키의 REST API 키 (클라이언트 시크릿을 켰다면 KAKAO_CLIENT_SECRET도)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# 네이버: developers.naver.com → 애플리케이션의 Client ID / Client Secret
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 구글: console.cloud.google.com → OAuth 클라이언트 ID(웹 애플리케이션)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
